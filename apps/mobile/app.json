{
  "expo": {
    "name": "UEI Charging (Demo)",
    "slug": "uei-charging",
    "scheme": "uei-charging",
    "version": "0.1.0",
    "orientation": "portrait",
    "android": { "package": "in.uei.charging.demo" },
    "ios": {
      "bundleIdentifier": "in.uei.charging.demo",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow UEI to scan a charger QR code.", "recordAudioAndroid": false }],
      ["expo-location", { "locationWhenInUsePermission": "Allow UEI to find chargers near your location." }]
    ]
  }
}
